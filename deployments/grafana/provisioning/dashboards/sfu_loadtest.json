{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "description": "SFU Load Test — Single Node Capacity",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "title": "🔴 Нагрузочный клиент",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "loadtest_clients_connected",
          "legendFormat": "Connected"
        }
      ],
      "title": "Клиентов подключено",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "loadtest_clients_failed_total",
          "legendFormat": "Failed"
        }
      ],
      "title": "Клиентов не подключилось",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(loadtest_connection_seconds_bucket[1m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(loadtest_connection_seconds_bucket[1m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(loadtest_connection_seconds_bucket[1m]))",
          "legendFormat": "p99"
        }
      ],
      "title": "Latency до Connected (p50/p95/p99)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "rate(loadtest_errors_total[1m])",
          "legendFormat": "errors/s ({{stage}})"
        }
      ],
      "title": "Ошибки клиента по этапам (rate/min)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "title": "🟢 SFU Сервер — Сигнализация",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "expr": "sfu_ws_connections_active",
          "legendFormat": "WS active"
        },
        {
          "expr": "sfu_peers_active",
          "legendFormat": "Peers active"
        },
        {
          "expr": "sfu_tracks_active",
          "legendFormat": "Tracks active"
        }
      ],
      "title": "Активные: WS / Peers / Tracks",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "expr": "rate(sfu_ws_connections_total[1m])",
          "legendFormat": "new conns/s"
        },
        {
          "expr": "rate(sfu_negotiations_total[1m])",
          "legendFormat": "negotiations/s"
        },
        {
          "expr": "rate(sfu_negotiations_deferred_total[1m])",
          "legendFormat": "deferred/s"
        }
      ],
      "title": "Подключения и переговорки (rate/min)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "expr": "rate(sfu_signaling_errors_total[1m])",
          "legendFormat": "errors/s ({{code}})"
        }
      ],
      "title": "Ошибки сигнализации SFU (rate/min)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "title": "📡 SFU Сервер — Медиа (RTP Hot Path)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "rate(sfu_rtp_packets_forwarded_total[1m])",
          "legendFormat": "pkts/s ({{kind}})"
        },
        {
          "expr": "rate(sfu_rtp_packets_dropped_total[1m])",
          "legendFormat": "dropped/s ({{kind}}/{{reason}})"
        }
      ],
      "title": "RTP пакеты: forwarded / dropped (rate/min)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "expr": "rate(sfu_rtp_bytes_forwarded_total[1m])",
          "legendFormat": "bytes/s ({{kind}})"
        }
      ],
      "title": "RTP пропускная способность (bytes/s)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(sfu_rtp_forward_duration_seconds_bucket[1m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(sfu_rtp_forward_duration_seconds_bucket[1m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(sfu_rtp_forward_duration_seconds_bucket[1m]))",
          "legendFormat": "p99"
        }
      ],
      "title": "RTP Forward Latency (p50/p95/p99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "title": "⚙️ SFU Сервер — Ресурсы",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"sfu-server\"}[1m])",
          "legendFormat": "SFU CPU"
        },
        {
          "expr": "rate(process_cpu_seconds_total{job=\"loadtest-client\"}[1m])",
          "legendFormat": "Loadtest CPU"
        }
      ],
      "title": "CPU Usage (cores/s)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "targets": [
        {
          "expr": "go_memstats_heap_inuse_bytes{job=\"sfu-server\"}",
          "legendFormat": "SFU Heap"
        },
        {
          "expr": "go_memstats_heap_inuse_bytes{job=\"loadtest-client\"}",
          "legendFormat": "Loadtest Heap"
        }
      ],
      "title": "Heap Memory In Use",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "targets": [
        {
          "expr": "go_goroutines{job=\"sfu-server\"}",
          "legendFormat": "SFU goroutines"
        },
        {
          "expr": "go_goroutines{job=\"loadtest-client\"}",
          "legendFormat": "Loadtest goroutines"
        }
      ],
      "title": "Goroutines",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": [
    "sfu",
    "loadtest",
    "webrtc"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "SFU Load Test — Single Node",
  "uid": "sfu-loadtest-v1",
  "version": 1
}